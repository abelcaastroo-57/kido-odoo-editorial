<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="editorial_item_tree" model="ir.ui.view"><field name="name">kido.editorial.item.tree</field><field name="model">kido.editorial.item</field><field name="arch" type="xml"><tree editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="product_id"/><field name="website_id"/><field name="brand"/><field name="need"/><field name="step"/><field name="ingredient"/><field name="badge"/><field name="routine_eligible"/><field name="collection"/><field name="local_key"/><field name="active"/></tree></field></record>
  <record id="editorial_item_action" model="ir.actions.act_window"><field name="name">Selección Kido: vincular productos reales</field><field name="res_model">kido.editorial.item</field><field name="view_mode">tree,form</field></record>
  <record id="quiz_question_form" model="ir.ui.view"><field name="name">kido.quiz.question.form</field><field name="model">kido.quiz.question</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="key"/><field name="sequence"/><field name="kicker"/><field name="hint"/></group><field name="option_ids"><tree editable="bottom"><field name="sequence" widget="handle"/><field name="value"/><field name="label"/><field name="description"/><field name="icon"/></tree></field><p>Las claves de pregunta y respuesta intervienen en las reglas de recomendación. Edite libremente textos; coordine cambios de claves con el módulo.</p></sheet></form></field></record>
  <record id="quiz_question_action" model="ir.actions.act_window"><field name="name">Cuestionario Kido</field><field name="res_model">kido.quiz.question</field><field name="view_mode">tree,form</field></record>
  <record id="club_consent_action" model="ir.actions.act_window"><field name="name">Consentimientos Club Kido</field><field name="res_model">kido.club.consent</field><field name="view_mode">tree,form</field></record>
  <record id="website_kido_form" model="ir.ui.view"><field name="name">website.kido.form</field><field name="model">website</field><field name="inherit_id" ref="website.view_website_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Kido Essence"><field name="kido_enabled" readonly="1"/><field name="kido_previous_homepage_id" readonly="1"/><field name="kido_shipping_notice"/><field name="kido_shipping_threshold"/><field name="kido_contact_team_id"/><field name="kido_mailing_list_id"/><field name="kido_terms_ready"/><field name="kido_reviews_verified"/><field name="kido_send_welcome"/><button name="action_kido_preview" type="object" string="Previsualizar Kido"/><button name="action_kido_activate" type="object" string="Activar diseño en este sitio" groups="base.group_system" confirm="Se publicarán las páginas Kido sin indexación y cambiará la portada de este sitio. Hágalo en preproducción. El botón Restaurar recupera la portada anterior."/><button name="action_kido_restore" type="object" string="Restaurar portada anterior" groups="base.group_system"/></group></xpath></field></record>
  <menuitem id="menu_kido" name="Kido Essence" parent="website.main_menu" sequence="80" groups="website.group_website_designer"/>
  <menuitem id="menu_kido_products" name="Selección y productos" parent="menu_kido" action="editorial_item_action" sequence="10"/>
  <menuitem id="menu_kido_questions" name="Cuestionario" parent="menu_kido" action="quiz_question_action" sequence="20"/>
  <menuitem id="menu_kido_consents" name="Consentimientos Club" parent="menu_kido" action="club_consent_action" sequence="30" groups="base.group_system"/>
  <record id="quiz_option_form" model="ir.ui.view"><field name="name">kido.quiz.option.form</field><field name="model">kido.quiz.option</field><field name="arch" type="xml"><form><sheet><group><field name="question_id"/><field name="value"/><field name="label"/><field name="description"/><field name="icon"/></group><field name="score_ids"><tree editable="bottom"><field name="need"/><field name="weight"/></tree></field></sheet></form></field></record>
  <record id="quiz_option_action" model="ir.actions.act_window"><field name="name">Reglas de recomendación Kido</field><field name="res_model">kido.quiz.option</field><field name="view_mode">tree,form</field></record>
  <menuitem id="menu_kido_rules" name="Reglas y prioridades" parent="menu_kido" action="quiz_option_action" sequence="25"/>
</odoo>
